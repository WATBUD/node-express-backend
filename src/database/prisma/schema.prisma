generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model record_log_table {
  id         Int       @id @default(autoincrement())
  data_text  String    @db.VarChar(200)
  created_at DateTime? @default(now()) @db.Timestamp(0)
}

model request_logs {
  Id               Int      @id @default(autoincrement())
  path             String   @db.VarChar(255)
  method           String   @db.VarChar(10)
  client_ip        String   @db.VarChar(45)
  created_at       DateTime @db.DateTime(0)
  backend_language String   @db.VarChar(50)
}

model users {
  user_id           Int                    @id @default(autoincrement())
  user_account      String                 @unique(map: "Account") @db.VarChar(100)
  // WatchLab legacy fields remain in this shared client model. INI Dating reads
  // profile fields from the normalized tables below through its repository.
  username          String                 @db.VarChar(50)
  password_hash     String                 @db.VarChar(256)
  email             String?                @db.VarChar(100)
  phone             String?                @db.VarChar(20)
  birthdate         DateTime?              @db.Date
  gender            String                 @db.VarChar(6)
  gender_changed_at DateTime?              @db.DateTime(3)
  avatar            String?                @db.VarChar(255)
  created_at        DateTime?              @default(now()) @db.Timestamp(0)
  updated_at        DateTime?              @default(now()) @db.Timestamp(0)
  is_banned         Boolean?               @default(false)
  is_test_account   Boolean                @default(false)
  profile           user_profiles?
  profile_options   user_profile_options[]
  custom_options    user_custom_options[]
  user_stock        user_stock[]
  submitted_reports safety_reports[] @relation("SubmittedSafetyReports")
  received_reports  safety_reports[] @relation("ReceivedSafetyReports")
}

model safety_reports {
  id               Int       @id @default(autoincrement())
  reporter_user_id Int
  reported_user_id Int
  reason_code      String    @db.VarChar(32)
  note             String?   @db.VarChar(500)
  status           String    @default("pending") @db.VarChar(20)
  created_at       DateTime  @default(now()) @db.Timestamp(0)
  reviewed_at      DateTime? @db.DateTime(0)
  reporter         users     @relation("SubmittedSafetyReports", fields: [reporter_user_id], references: [user_id], onDelete: Cascade)
  reported         users     @relation("ReceivedSafetyReports", fields: [reported_user_id], references: [user_id], onDelete: Cascade)

  @@index([reporter_user_id, created_at])
  @@index([reported_user_id, status, created_at])
  @@index([reason_code, status, created_at])
}

model user_profiles {
  user_id             Int       @id
  display_name        String    @db.VarChar(50)
  birthdate           DateTime? @db.Date
  gender              String    @db.VarChar(6)
  gender_changed_at   DateTime? @db.DateTime(3)
  avatar_id           String?   @db.VarChar(255)
  location            String?   @db.VarChar(100)
  headline            String?   @db.VarChar(100)
  bio                 String?   @db.VarChar(200)
  zodiac              String?   @db.VarChar(20)
  relationship        String?   @db.VarChar(30)
  looking_for         String?   @db.VarChar(30)
  profile_initialized Boolean   @default(false)
  created_at          DateTime? @default(now()) @db.Timestamp(0)
  updated_at          DateTime? @default(now()) @db.Timestamp(0)
  user                users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model user_profile_options {
  id          Int      @id @default(autoincrement())
  user_id     Int
  option_type String   @db.VarChar(12)
  option_key  String   @db.VarChar(50)
  created_at  DateTime @default(now()) @db.Timestamp(0)
  user        users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([user_id, option_type, option_key])
  @@index([option_type, option_key])
}

model user_custom_options {
  id                Int      @id @default(autoincrement())
  user_id           Int
  option_type       String   @db.VarChar(12)
  value             String   @db.VarChar(20)
  normalized_value  String   @db.VarChar(20)
  moderation_status String   @default("approved") @db.VarChar(16)
  created_at        DateTime @default(now()) @db.Timestamp(0)
  user              users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([user_id, option_type, normalized_value])
  @@index([option_type, normalized_value, moderation_status])
}

model user_stock {
  id         Int       @id @default(autoincrement())
  stock_id   String    @db.VarChar(10)
  user_id    Int
  note       String?   @db.VarChar(255)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @db.Timestamp(0)
  is_blocked Boolean?  @default(false)
  user       users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, map: "user_stock_user_fk")

  @@unique([stock_id, user_id], map: "user_stock_key")
  @@index([user_id], map: "user_stock_user_id_idx")
}

model daily_price {
  id         Int       @id @default(autoincrement())
  stock_id   String    @db.VarChar(10)
  name       String?   @db.VarChar(50)
  trade_date DateTime  @db.Date
  open       Decimal?  @db.Decimal(12, 4)
  high       Decimal?  @db.Decimal(12, 4)
  low        Decimal?  @db.Decimal(12, 4)
  close      Decimal?  @db.Decimal(12, 4)
  volume     BigInt?
  created_at DateTime? @default(now()) @db.Timestamp(0)

  @@unique([stock_id, trade_date], map: "daily_price_key")
  @@index([trade_date], map: "daily_price_trade_date_idx")
}

model stock {
  stock_id   String    @id @db.VarChar(10)
  name       String?   @db.VarChar(50)
  updated_at DateTime? @default(now()) @db.Timestamp(0)
}
